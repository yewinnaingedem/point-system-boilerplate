APP_NAME="POS System"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=30
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Docker MySQL (compose.yaml). From the host: 127.0.0.1:3308; containers use mysql:3306.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3308
DB_DATABASE=pos_system
DB_USERNAME=pos_user
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6380

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

ADMIN_EMAIL=admin@pos.test
ADMIN_PASSWORD=password

# API (Modules/Api)
CORS_ALLOWED_ORIGINS=
API_TOKEN_TTL_DAYS=30
API_MAX_DEVICES=3
API_RATE_PER_MINUTE=60

# Docker (compose.yaml): host ports and the uid/gid the PHP containers run as (`id -u`, `id -g`).
APP_PORT=8080
FORWARD_DB_PORT=3308
FORWARD_REDIS_PORT=6380
DOCKER_UID=1000
DOCKER_GID=1000

# Customer sign-in from the partner Laravel project (docs/customer-sso.md).
# Same secret on both sides, at least 32 characters; sign-in is off while it is empty.
CUSTOMER_SSO_SECRET=
CUSTOMER_SSO_ISSUER=
CUSTOMER_SSO_AUDIENCE="${APP_URL}"
CUSTOMER_TOKEN_TTL_DAYS=90
CUSTOMER_MAX_DEVICES=5

# Partner project, server to server: award points (docs/partner-api.md).
# At least 32 characters; the partner API is off while it is empty.
PARTNER_API_KEY=
PARTNER_API_ALLOWED_IPS=
PARTNER_API_RATE_PER_MINUTE=120
